---
import Base from '../layouts/Base.astro';
import TopicFilter from '../components/TopicFilter.astro';
import Item from '../components/Item.astro';
import EvidenceList from '../components/EvidenceList.astro';
import { challenges, topicOrder } from '../data';

const items = [...challenges].sort((a, b) => topicOrder(a) - topicOrder(b));
---
<Base title="Challenges" description="Problems that remain even when the recommendations are followed.">
  <h1>Challenges</h1>
  <p>Problems that remain even when the recommendations are followed.</p>

  <TopicFilter noun="challenges" />

  <div class="ruled">
    {items.map((c) => (
      <Item id={c.id} title={c.title} topics={c.topics} level={2}>
        <div class="rec-grid">
          <p>{c.summary}</p>
          <EvidenceList ids={c.evidence} />
        </div>
      </Item>
    ))}
  </div>
</Base>
