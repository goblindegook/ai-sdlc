---
// Redrawn from the source doc's "how the practices fit together" figure. Colours follow the page tokens.
import { STEPS } from '../data/workflow';
const W = 128, H = 72, y = 118;
const steps = STEPS.map((s, i) => ({ ...s, x: 92 + 144 * i }));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Phones get the same diagram drawn top to bottom instead of a cropped wide one.
const TW = 200, TH = 58, cx = 170, top = (i: number) => 16 + i * 88;
---
<figure class="diagram">
  <svg class="diagram-wide" viewBox="0 50 760 250" role="img" aria-labelledby="loop-title loop-desc" font-family="var(--text)" font-size="13">
    <title id="loop-title">Humans own intent and checks; agents loop inside the gates</title>
    <desc id="loop-desc">Five steps left to right: Plan, Tests, Agent loop, Review, Ship. Only the agent loop is automated and repeats until a machine check passes. Production signals feed the next plan. Shared understanding sits underneath every step.</desc>
    <defs>
      <marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill="var(--muted)" />
      </marker>
    </defs>
    <g fill="none" stroke="var(--muted)" stroke-width="1.25">
      {steps.slice(0, -1).map((s, i) => <path d={`M${s.x + W / 2} ${y}H${steps[i + 1].x - W / 2}`} marker-end="url(#arr)" />)}
      <path d={`M${380 + 24} ${y - H / 2}C${404} ${y - H / 2 - 24} ${356} ${y - H / 2 - 24} ${356} ${y - H / 2}`} marker-end="url(#arr)" />
      <path d={`M668 ${y + H / 2}V204H92V${y + H / 2}`} marker-end="url(#arr)" />
    </g>
    <text x="414" y={y - H / 2 - 12} font-size="11.5" fill="var(--muted)">until a machine check passes</text>
    {steps.map((s) => (
      <a href={`${base}/recommendations/?topic=${s.topic}`}>
        <rect x={s.x - W / 2} y={y - H / 2} width={W} height={H} rx="3"
          fill={s.agent ? 'var(--ink)' : 'var(--paper)'} stroke="var(--ink)" stroke-width={s.agent ? 0 : 1.75} />
        <text class="step-name" x={s.x} y={y - 9} text-anchor="middle" font-size="16" fill={s.agent ? 'var(--paper)' : 'var(--ink)'}>{s.name}</text>
        <text x={s.x} y={y + 9} text-anchor="middle" font-size="11.5" fill={s.agent ? 'var(--paper)' : 'var(--muted)'}>{s.l1}</text>
        <text x={s.x} y={y + 24} text-anchor="middle" font-size="11.5" fill={s.agent ? 'var(--paper)' : 'var(--muted)'}>{s.l2}</text>
      </a>
    ))}
    <text x="380" y="198" text-anchor="middle" font-size="11.5" fill="var(--muted)">production signals and customer feedback shape the next plan</text>
    <a href={`${base}/recommendations/?topic=understanding`}>
      <rect x="28" y="228" width="704" height="50" rx="3" fill="var(--paper-2)" stroke="var(--rule)" />
      <text class="step-name" x="380" y="250" text-anchor="middle" font-size="15" fill="var(--ink)">Shared understanding underneath every step</text>
      <text x="380" y="268" text-anchor="middle" font-size="11.5" fill="var(--muted)">protect learning and hands-on practice</text>
    </a>
  </svg>
  <svg class="diagram-tall" viewBox="0 0 340 516" role="img" aria-labelledby="loop-title-tall" font-family="var(--text)" font-size="13">
    <title id="loop-title-tall">Humans own intent and checks; agents loop inside the gates</title>
    <defs>
      <marker id="arr-tall" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill="var(--muted)" />
      </marker>
    </defs>
    <g fill="none" stroke="var(--muted)" stroke-width="1.25">
      {steps.slice(0, -1).map((_, i) => <path d={`M${cx} ${top(i) + TH}V${top(i + 1)}`} marker-end="url(#arr-tall)" />)}
      <path d={`M${cx + TW / 2} ${top(2) + 14}C${cx + TW / 2 + 32} ${top(2) + 14} ${cx + TW / 2 + 32} ${top(2) + 44} ${cx + TW / 2} ${top(2) + 44}`} marker-end="url(#arr-tall)" />
      <path d={`M${cx - TW / 2} ${top(4) + TH / 2}H40V${top(0) + TH / 2}H${cx - TW / 2}`} marker-end="url(#arr-tall)" />
    </g>
    <text x="318" y={top(2) + 29} text-anchor="middle" font-size="11" fill="var(--muted)" transform={`rotate(90 318 ${top(2) + 29})`}>until a check passes</text>
    <text x="28" y={top(2) + 29} text-anchor="middle" font-size="11" fill="var(--muted)" transform={`rotate(-90 28 ${top(2) + 29})`}>production signals shape the next plan</text>
    {steps.map((s, i) => (
      <a href={`${base}/recommendations/?topic=${s.topic}`}>
        <rect x={cx - TW / 2} y={top(i)} width={TW} height={TH} rx="3"
          fill={s.agent ? 'var(--ink)' : 'var(--paper)'} stroke="var(--ink)" stroke-width={s.agent ? 0 : 1.75} />
        <text class="step-name" x={cx} y={top(i) + 23} text-anchor="middle" font-size="16" fill={s.agent ? 'var(--paper)' : 'var(--ink)'}>{s.name}</text>
        <text x={cx} y={top(i) + 41} text-anchor="middle" font-size="11.5" fill={s.agent ? 'var(--paper)' : 'var(--muted)'}>{s.l1} {s.l2}</text>
      </a>
    ))}
    <a href={`${base}/recommendations/?topic=understanding`}>
      <rect x="20" y="448" width="300" height="56" rx="3" fill="var(--paper-2)" stroke="var(--rule)" />
      <text class="step-name" x={cx} y="472" text-anchor="middle" font-size="15" fill="var(--ink)">Shared understanding under every step</text>
      <text x={cx} y="490" text-anchor="middle" font-size="11.5" fill="var(--muted)">protect learning and hands-on practice</text>
    </a>
  </svg>
  <figcaption>
    Only the agent loop (filled) runs without a person; every other step needs human judgement.
  </figcaption>
</figure>
