---
// The one way the site cites sources: links to the source's entry on the Evidence page.
// Only the Evidence page links out to the original.
import { evidenceById } from '../data';
// `level` is the sub-heading's level: one below the item title it sits in, so the outline never skips a level.
interface Props { ids: string[]; level?: 3 | 4 }
const { ids, level = 4 } = Astro.props;
const H = `h${level}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const KIND: Record<string, string> = {
  rct: 'RCT', study: 'study', benchmark: 'benchmark', telemetry: 'telemetry', survey: 'survey',
  vendor: 'vendor', practitioner: 'practitioner', essay: 'essay',
};
---
<div class="evidence-list">
  <H class="sub">Evidence</H>
  {ids.length ? (
    <ul class="cites">
      {ids.map((id) => {
        const e = evidenceById.get(id)!;
        return <li><a href={`${base}/evidence/#${e.id}`}>{e.title}</a> <span class="kind">{KIND[e.kind] ?? e.kind}</span></li>;
      })}
    </ul>
  ) : (
    <p class="meta">No direct evidence cited.</p>
  )}
</div>
