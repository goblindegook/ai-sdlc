---
// Topic filter (and optional text search) for a list page. Items opt in with data-item data-topics="a b c".
// One topic at a time, or All. State lives in the URL only (?topic=slug&q=word), so a shared link shows what the sender saw.
import { TOPICS } from '../data/topics';
interface Props { noun: string }
const { noun } = Astro.props;
---
<div class="topicbar" data-topicbar>
  <div class="search">
    <button type="button" class="search-open" data-search-open>
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><circle cx="6.5" cy="6.5" r="4.75" fill="none" stroke="currentColor" stroke-width="1.75" /><path d="m10.25 10.25 4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" /></svg>
      Search
    </button>
    <div class="search-field" data-search-field hidden>
      <label class="search-label">
        <span class="visually-hidden">Search {noun}</span>
        <input type="search" data-search placeholder={`Search ${noun}`} autocomplete="off" />
      </label>
      <button type="button" class="search-close" data-search-close aria-label="Close search and clear it">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="m3.5 3.5 9 9m0-9-9 9" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" /></svg>
      </button>
    </div>
  </div>
  <div class="topicbar-row" role="group" aria-label="Filter by topic" data-tabs>
    <button type="button" class="topic-toggle" data-topic="" aria-pressed="true">All</button>
    {TOPICS.map((t) => (
      <button type="button" class="topic-toggle" data-topic={t.slug} aria-pressed="false">{t.label}</button>
    ))}
  </div>
  <button type="button" class="expand" data-expand aria-pressed="false">Expand all</button>
  <p class="hint" aria-live="polite" data-hint></p>
</div>

<script>
  // Pages change without a reload, so this module runs once and sets the filter up again on every page load.
  // Listeners on document and window are dropped with the page they belong to.
  let pageListeners = new AbortController();
  document.addEventListener('astro:page-load', () => {
    pageListeners.abort();
    pageListeners = new AbortController();
    if ('highlights' in CSS) CSS.highlights.delete('search');
    if (document.querySelector('[data-topicbar]')) setUp(pageListeners.signal);
  });

  function setUp(signal: AbortSignal) {
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-topicbar] [data-topic]')];
    const topics = buttons.map((b) => b.dataset.topic!).filter(Boolean);
    const searchBox = document.querySelector<HTMLInputElement>('[data-search]')!;
    const items = [...document.querySelectorAll<HTMLElement>('[data-item]')];
    const text = new Map(items.map((el) => [el, el.textContent!.toLowerCase()]));

    const params = new URLSearchParams(location.search);
    const first = (params.get('topic') ?? params.get('tags') ?? '').split(',')[0];
    let topic = topics.includes(first) ? first : ''; // '' means all topics
    let query = params.get('q') ?? '';
    searchBox.value = query;

    // While searching, open the matching items and highlight the words, so it's clear why each one matched.
    // Items the search opened fold back when the search is cleared; items the reader opened stay open.
    const openedBySearch = new Set<HTMLDetailsElement>();
    const reveal = (words: string[]) => {
      for (const d of items as HTMLDetailsElement[]) {
        if (words.length && !d.hidden && !d.open) { d.open = true; openedBySearch.add(d); }
        else if ((!words.length || d.hidden) && openedBySearch.has(d)) { d.open = false; openedBySearch.delete(d); }
      }
      if (!('highlights' in CSS)) return; // ponytail: no highlight on browsers without the CSS Highlight API
      const ranges: Range[] = [];
      if (words.length) for (const el of items) {
        if (el.hidden) continue;
        const walk = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
        for (let n = walk.nextNode(); n; n = walk.nextNode()) {
          const t = n.textContent!.toLowerCase();
          for (const w of words) for (let i = t.indexOf(w); i !== -1; i = t.indexOf(w, i + w.length)) {
            const r = new Range(); r.setStart(n, i); r.setEnd(n, i + w.length); ranges.push(r);
          }
        }
      }
      CSS.highlights.set('search', new Highlight(...ranges));
    };

    const apply = () => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.topic === topic)));
      const words = query.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0; // only used to say when nothing matches
      items.forEach((el) => {
        const hit = (!topic || el.dataset.topics!.split(' ').includes(topic)) && words.every((w) => text.get(el)!.includes(w));
        el.hidden = !hit;
        if (hit) shown++;
      });
      document.querySelectorAll<HTMLElement>('[data-group]').forEach((g) => {
        const n = g.querySelectorAll('[data-item]:not([hidden])').length;
        if (g.hasAttribute('data-hide-empty')) g.hidden = n === 0;
      });
      document.querySelector('[data-hint]')!.textContent = shown ? '' : 'Nothing matches. Try another topic or fewer words.';
      reveal(words);
      const url = new URL(location.href);
      url.searchParams.delete('tags'); // old links used ?tags=
      topic ? url.searchParams.set('topic', topic) : url.searchParams.delete('topic');
      query ? url.searchParams.set('q', query) : url.searchParams.delete('q');
      history.replaceState(history.state, '', url); // keep the router's state, or back and forward break
    };

    // Expand all / Collapse all acts on the items currently shown.
    const expand = document.querySelector<HTMLButtonElement>('[data-expand]')!;
    const visible = () => items.filter((el) => !el.hidden) as HTMLDetailsElement[];
    const syncExpand = () => {
      const all = visible().length > 0 && visible().every((d) => d.open);
      expand.textContent = all ? 'Collapse all' : 'Expand all';
      expand.setAttribute('aria-pressed', String(all));
    };
    expand.addEventListener('click', () => {
      const open = expand.getAttribute('aria-pressed') !== 'true';
      visible().forEach((d) => (d.open = open));
      syncExpand();
    });
    items.forEach((d) => d.addEventListener('toggle', syncExpand));

    buttons.forEach((b) => b.addEventListener('click', () => { topic = b.dataset.topic!; apply(); syncExpand(); }));
    searchBox.addEventListener('input', () => { query = searchBox.value.trim(); apply(); syncExpand(); });

    // Search is a button until used; the close button clears the search and folds it away again.
    const openBtn = document.querySelector<HTMLButtonElement>('[data-search-open]')!;
    const field = document.querySelector<HTMLElement>('[data-search-field]')!;
    const tabs = document.querySelector<HTMLElement>('[data-tabs]')!;
    const topicbar = document.querySelector<HTMLElement>('[data-topicbar]')!;
    // An open search takes the tabs' place in the row. The chosen topic still applies; the tabs return on close.
    const setSearchOpen = (open: boolean) => {
      field.hidden = !open; openBtn.hidden = open; tabs.hidden = open;
      topicbar.classList.toggle('searching', open);
    };
    openBtn.addEventListener('click', () => { setSearchOpen(true); searchBox.focus(); });
    const closeSearch = () => {
      searchBox.value = ''; query = ''; apply(); syncExpand();
      setSearchOpen(false); openBtn.focus();
    };
    document.querySelector('[data-search-close]')!.addEventListener('click', closeSearch);
    searchBox.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeSearch(); });
    setSearchOpen(query !== ''); // a shared ?q= link shows its search
    // Topic links on items switch this page to that topic without a reload.
    document.addEventListener('click', (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('[data-topic-link]');
      if (!a || e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      topic = a.dataset.topicLink!;
      apply();
      document.querySelector('[data-topicbar]')!.scrollIntoView({ block: 'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    }, { signal });
    apply();

    // A link to an item opens it.
    const openTarget = () => {
      const el = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
      if (el instanceof HTMLDetailsElement) el.open = true;
    };
    openTarget();
    addEventListener('hashchange', openTarget, { signal });
  }
</script>
