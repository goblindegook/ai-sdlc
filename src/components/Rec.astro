---
import Item from './Item.astro';
import EvidenceList from './EvidenceList.astro';
import type { Rec } from '../data';

interface Props { rec: Rec; level?: 2 | 3 }
const { rec: r, level } = Astro.props;
const sub = (level ?? 3) + 1 as 3 | 4; // sub-headings sit one level below the item title
const H = `h${sub}`;
---
<Item id={r.id} title={r.title} topics={r.topics} level={level} ring={r.ring}>
  <div class="rec-grid">
    <div>
      <p>{r.summary}</p>
      {r.signals.length > 0 && (
        <>
          <H class="sub">Watch for</H>
          <ul>{r.signals.map((s) => <li>{s}</li>)}</ul>
        </>
      )}
    </div>
    <EvidenceList ids={r.evidence} level={sub} />
  </div>
</Item>
