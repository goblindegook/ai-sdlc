---
import '../styles/global.css';
import { updated } from '../data';

interface Props { title: string; description?: string }
const { title, description = 'Evidence-linked practices for building software with AI coding agents.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '').replace(/\/$/, '') || '/';
const links = [
  ['/', 'Overview'],
  ['/recommendations', 'Recommendations'],
  ['/challenges', 'Challenges'],
  ['/questions', 'Open questions'],
  ['/evidence', 'Evidence'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'Overview' ? 'AI-Augmented Software Development' : `${title} · AI-Augmented Software Development`}</title>
    <meta name="description" content={description} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    {import.meta.env.PROD && <script is:inline src={`${base}/registerSW.js`}></script>}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..100,500..800&family=Atkinson+Hyperlegible+Next:wght@400;500;600;700&display=swap"
    />
  </head>
  <body>
    <header class="site-head">
      <div class="wrap">
        <a class="wordmark" href={`${base}/`}>AI-Augmented Software Development</a>
        <nav aria-label="Main">
          <ul>
            {links.map(([href, label]) => (
              <li><a href={`${base}${href}${href === '/' ? '' : '/'}`} aria-current={path === href ? 'page' : undefined}>{label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-foot">
      <div class="wrap">
        <p>
          Independent notes, not affiliated with or endorsed by any employer or vendor. Updated {updated}.
        </p>
      </div>
    </footer>
    <script>
      // The header wraps on narrow screens, so the filter bar sticks at the header's measured height.
      const head = document.querySelector<HTMLElement>('.site-head')!;
      const sync = () => document.documentElement.style.setProperty('--head-h', `${head.offsetHeight}px`);
      new ResizeObserver(sync).observe(head);
      sync();
    </script>
  </body>
</html>
